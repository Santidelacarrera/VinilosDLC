# URL del proyecto Supabase. No termina en slash.
SUPABASE_URL=https://ujswessaedegncxeoeio.supabase.co

# Clave service_role: sólo Netlify Functions. Nunca usar en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Resultado de `npm run secrets:generate` (scrypt; no es la contraseña).
ADMIN_PASSWORD_HASH=

# Secreto aleatorio de al menos 32 bytes para firmar sesiones.
SESSION_SECRET=

# Origen canónico de producción, usado para validar CSRF.
SITE_URL=https://vinilosdelacarrera.netlify.app

# URL HTTPS de contacto del responsable para el User-Agent de MusicBrainz.
# Si no se establece, se usa SITE_URL.
MUSICBRAINZ_CONTACT=https://vinilosdelacarrera.netlify.app
